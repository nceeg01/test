import { useState } from "react";

const C = {
  bg:"#F4F6FA",surf:"#FFFFFF",brd:"#DDE2EE",pri:"#1A3A5C",
  acc:"#2E7DCC",accL:"#EBF4FF",txt:"#1C2B3A",mut:"#6B7A90",
  ok:"#27AE60",warn:"#F39C12",err:"#E74C3C",ann:"#E8400C",
  wf:"#E8ECF4",wfd:"#C5CDD8",
