const Ann=({n,style,label})=>(
  <div style={{position:"absolute",display:"flex",alignItems:"flex-start",gap:5,zIndex:40,...style}}>
    <div style={{minWidth:20,height:20,borderRadius:"50%",background:C.ann,color:"#fff",fontSize:10,fontWeight:800,display:"flex",alignItems:"center",justifyContent:"center",flexShrink:0,boxShadow:"0 2px 5px rgba(232,64,12,.4)"}}>{n}</div>
    <div style={{background:"#fff",border:`1px solid ${C.ann}`,borderRadius:5,padding:"2px 7px",fontSize:10,color:C.ann,fontWeight:700,whiteSpace:"nowrap",boxShadow:"0 1px 4px rgba(0,0,0,.08)"}}>{label}</div>
  </div>
);

const Leg=({items})=>(
  <div style={{background:"#fff",border:`1px solid ${C.brd}`,borderRadius:10,padding:"14px 18px",boxShadow:"0 2px 8px rgba(0,0,0,.06)"}}>
    <div style={{fontSize:11,fontWeight:800,color:C.pri,marginBottom:10,textTransform:"uppercase",letterSpacing:.8}}>📌 Annotation Legend</div>
    <div style={{display:"flex",flexDirection:"column",gap:7}}>
      {items.map(([n,t])=>(
        <div key={n} style={{display:"flex",gap:8,alignItems:"flex-start"}}>
          <div style={{minWidth:19,height:19,borderRadius:"50%",background:C.ann,color:"#fff",fontSize:10,fontWeight:800,display:"flex",alignItems:"center",justifyContent:"center",flexShrink:0,marginTop:1}}>{n}</div>
          <span style={{fontSize:11.5,color:C.txt,lineHeight:1.5}}>{t}</span>
        </div>
      ))}
    </div>
  </div>
);

const Inp=({style,children})=>(
  <div style={{border:`1.5px solid ${C.brd}`,borderRadius:8,padding:"8px 12px",fontSize:12.5,background:"#fff",color:C.txt,...style}}>{children}</div>
);

const BtnP=({style,children})=>(
  <button style={{background:C.acc,color:"#fff",border:"none",borderRadius:8,padding:"9px 18px",fontSize:12.5,fontWeight:700,cursor:"pointer",...style}}>{children}</button>
);

const BtnS=({style,children})=>(
